{
  "name": "last-epoch-assistant",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "fetch": "yarn workspace @le/fetch run fetch",
    "db:build": "yarn workspace @le/db run build-db",
    "setup": "yarn fetch && yarn db:build",
    "mcp": "yarn workspace @le/mcp run start",
    "mcp:call": "yarn workspace @le/mcp run call",
    "mcp:list": "yarn workspace @le/mcp run list",
    "probes:verify": "node tests/probes/make-questions.js --verify",
    "skills:check": "tsx tests/skill-examples/runner.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
